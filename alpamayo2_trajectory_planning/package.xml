<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>alpamayo2_trajectory_planning</name>
  <version>1.0.0</version>
  <description>ROS 2 trajectory planning using NVIDIA Alpamayo 2 Super</description>

  <maintainer email="vankempen@thinking-cars.de">Raphael van Kempen</maintainer>
  <author email="vankempen@thinking-cars.de">Raphael van Kempen</author>

  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>perception_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_planning_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
